{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.12 \"$CLAUDE_PROJECT_DIR/tools/jobreg.py\" hook --mode warn 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

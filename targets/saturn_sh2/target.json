  "known_blockers": [
    {
      "name": "R8 code read (input generator lets random pointers reach code; fix the generator, not R8)",
      "rx": "^R8: read machine code at ",
      "after": 2
    }
  ],
  "blocker_kinds": [
    {
      "id": "ghidra_timeout",
      "status": [
        "error"
      ],
      "detail": "^Ghidra (timeout|stopped)",
      "fix": "infrastructure: re-run the preparation alone on an idle machine with a longer ghidra_timeout_s; if it still times out, read the slot log for the hanging script"
    },
    {
      "id": "fpu_bank_mode",
      "status": [
        "skipped"
      ],
      "detail": "^unsupported: float pair/bank mode switch",
      "fix": "checker (batch 7, fpu_state): the whole FPU (fr0..15, XMTRX, FPSCR.FR/SZ/PR) is state for mode-switching functions; re-prepare these"
    },
    {
      "id": "xmtrx",
      "status": [
        "failed"
      ],
      "detail": "^blocked: XMTRX",
      "diff": "^xf\\d+ \\(XMTRX\\): ",
      "fix": "checker (batch 7, fpu_state): XMTRX is compared at exit and at every call (sh4_frchg, sh4_fschg, sh4_ftrv_fv); re-prepare these"
    },
    {
      "id": "entry_regs",
      "status": [
        "skipped"
      ],
      "detail": "^unsupported: reads (f?r\\d+(, )?)+ at entry",
      "fix": "checker: parameter storage r0..r3 and fr4..fr11 read before written (signature inputs from dataflow); entry fr0..fr3 alone as FPU state (8f96131)",
      "fixed_at": "2026-10-18T18:59:38"
    },
    {
      "id": "odd_return",
      "status": [
        "skipped"
      ],
      "detail": "^unsupported: (return in r\\d+|\\d+-bit return value)",
      "fix": "checker: any return register, and a u64 return in r0:r1, in the harness and runtime"
    },
    {
      "id": "decompile_failed",
      "status": [
        "skipped"
      ],
      "detail": "^unsupported: decompile failed",
      "fix": "packet: asm-only packet with a signature from dataflow; Haiku translates from the asm"
    },
    {
      "id": "outside_body",
      "status": [
        "skipped"
      ],
      "detail": "^unsupported: executes code outside its body",
      "fix": "checker: cross-module calls (an overlay jumping into another overlay or the main binary)"
    },
    {
      "id": "oracle_bad_pointers",
      "status": [
        "skipped"
      ],
      "detail": "^oracle could not produce .*(write outside RAM|fault: read)",
      "fix": "oracle: seed pointer-like parameters (and pointers loaded through them) into a scratch RAM window"
    },
    {
      "id": "oracle_call_loop",
      "status": [
        "skipped"
      ],
      "detail": "^oracle could not produce .*more than \\d+ calls",
      "fix": "oracle: model PR-redirected tail calls (lds rN,PR then bra: the callee returns to the loaded PR); check for data seeded as code"
    },
    {
      "id": "oracle_underflow",
      "status": [
        "skipped"
      ],
      "detail": "^oracle could not produce .*float underflow",
      "fix": "oracle: model FPSCR.DN denormal flush instead of rejecting the run"
    },
    {
      "id": "oracle_step_limit",
      "status": [
        "skipped"
      ],
      "detail": "^oracle could not produce .*step limit",
      "fix": "oracle: an input-dependent loop the random inputs never end, or data seeded as code; read the function first"
    },
    {
      "id": "oracle_emulation_error",
      "status": [
        "skipped"
      ],
      "detail": "^oracle could not produce .*emulation error",
      "fix": "oracle/SLEIGH: an instruction the emulator cannot decode; usually data seeded as code (prune it)"
    },
    {
      "id": "r8_code_read",
      "status": [
        "failed"
      ],
      "detail": "^blocked: R8",
      "diff": "^R8: read machine code at ",
      "fix": "oracle: keep pointer inputs out of the code range in the input generator; do not loosen R8"
    },
    {
      "id": "invalid_access",
      "status": [
        "failed"
      ],
      "diff": "^invalid guest memory access",
      "fix": "oracle: random pointers reach unmapped memory on the C side; seed pointers into RAM (same fix as oracle_bad_pointers)"
    },
    {
      "id": "float_inputs_missing",
      "status": [
        "failed"
      ],
      "diff_all": true,
      "diff": "^(fr1[2-5] \\(vector register, sh4_fr\\(\\d+\\)\\) at exit|call #\\d+ to 0x[0-9a-f]+: argument fr\\d+ )",
      "fix": "checker: TcPrepare adds fr4..fr11 read before written as parameters (entry float registers the C cannot see)"
    },
    {
      "id": "hidden_only",
      "status": [
        "failed"
      ],
      "diff": "only in the hidden set",
      "fix": "retry: more dev vectors (e.g. 96) so the edge case shows in dev; the hidden check is unchanged"
    },
    {
      "id": "crash_or_hang",
      "status": [
        "failed"
      ],
      "diff": "^(no result for this vector|C code raised exception)",
      "fix": "retry: the C crashes or loops on some vectors; one more Haiku run from its best work.c"
    },
    {
      "id": "translation_mismatch",
      "status": [
        "failed"
      ],
      "diff_all": true,
      "diff": "^(memory 0x|return value |call #\\d+|\\.\\.\\. and \\d+ more differing)",
      "fix": "retry: a real translation mistake (memory, return value, call target or argument); one more Haiku run from its best work.c"
    },
    {
      "id": "no_build",
      "status": [
        "failed"
      ],
      "stage": "^(build|lint)$",
      "fix": "retry: the last attempt does not build or breaks a rule; one more Haiku run from its best work.c"
    }
  ],
  "translator": {
    "name": "sh2-translate",
    "command": ["{python}", "{target}/translate.py", "--repo", "{repo}", "--binary", "{binary}", "--addr", "{addr}",
                "--meta", "{meta}", "--target-json", "{target_json}", "--bodies", "{bodies}", "--out", "{out}"],

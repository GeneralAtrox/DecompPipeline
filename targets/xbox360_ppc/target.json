  "known_blockers": [],
  "blocker_kinds": [
    {"id": "ghidra_timeout", "status": ["error"], "detail": "^Ghidra (timeout|stopped)",
     "fix": "infrastructure: re-run the preparation alone on an idle machine with a longer ghidra_timeout_s"},
    {"id": "unsupported_insn", "status": ["skipped"],
     "detail": "^unsupported: (VMX|estimate|atomic|cache|system|FPSCR|CALLOTHER)",
     "fix": "target: model the instruction class in TcFixups and the runtime (phase 2 for VMX), then re-prepare"},
    {"id": "frame_helper", "status": ["skipped"], "detail": "^frame helper",
     "fix": "none: a register save/restore helper runs inline in its callers"},
    {"id": "decompile_failed", "status": ["skipped"], "detail": "^unsupported: decompile failed",
     "fix": "packet: asm-only packet with a signature from dataflow"},
    {"id": "outside_body", "status": ["skipped"], "detail": "^unsupported: executes code outside its body",
     "fix": "catalog: a switch case or shared tail outside the function body"},
    {"id": "oracle_bad_pointers", "status": ["skipped"], "detail": "^oracle could not produce .*(write outside RAM|fault: read)",
     "fix": "oracle: seed pointer-like parameters into the scratch window (TcInputs, hints)"},
    {"id": "oracle_step_limit", "status": ["skipped"], "detail": "^oracle could not produce .*step limit",
     "fix": "oracle: an input-dependent loop the random inputs never end; read the function first"},
    {"id": "oracle_emulation_error", "status": ["skipped"], "detail": "^oracle could not produce .*emulation error",
     "fix": "oracle/SLEIGH: an instruction the emulator cannot run (a CALLOTHER without a callback)"},
    {"id": "r8_code_read", "status": ["failed"], "detail": "^blocked: R8", "diff": "^R8: read machine code at ",
     "fix": "oracle: keep pointer inputs out of the code range"},
    {"id": "hidden_only", "status": ["failed"], "diff": "only in the hidden set",
     "fix": "retry: more dev vectors so the edge case shows in dev"},
    {"id": "crash_or_hang", "status": ["failed"], "diff": "^(no result for this vector|C code raised exception)",
     "fix": "retry: the C crashes or loops on some vectors"},
    {"id": "upper_word", "status": ["failed"], "diff": "only the upper word differs",
     "fix": "signature: the original's r3 upper word is not the declared extension; return u64/s64"},
    {"id": "translation_mismatch", "status": ["failed"], "diff_all": true,
     "diff": "^(memory 0x|return value |call #\\d+|\\.\\.\\. and \\d+ more differing)",
     "fix": "retry: a real translation mistake"},
    {"id": "no_build", "status": ["failed"], "stage": "^(build|lint)$",
     "fix": "retry: the last attempt does not build or breaks a rule"}
  ]
}
